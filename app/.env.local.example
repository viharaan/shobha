# Copy to app/.env.local (git-ignored). Never commit real keys.

# Google Maps Platform key with the "Map Tiles API" enabled, restricted to your site's HTTP referrers.
# Enables "Photoreal 3D (Google)" on /geo and /explore. Exposed to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ElevenLabs key, used only by `npm run narration` on your machine to pre-generate tour MP3s.
# Not exposed to the browser and not needed in production.
ELEVENLABS_API_KEY=
# Optional: voice and model for the narration build.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
